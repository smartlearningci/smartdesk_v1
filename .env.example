# SMART LEARNING · SmartDesk · configuração de demonstração LOCAL
# Copiar para .env antes de executar Docker Compose.
# Valores fictícios: alterar as palavras-passe antes de qualquer utilização real.
# O ficheiro .env não deve ser enviado para o GitHub.

# Base de dados PostgreSQL do SmartDesk original.
POSTGRES_DB=smartdesk
POSTGRES_USER=smartdesk
POSTGRES_PASSWORD=smartdesk_aula_2026_alterar

# Chave para assinatura dos cookies de sessão (32 caracteres ou mais).
# Não é uma palavra-passe de utilizador e não deve ser reutilizada em produção.
SMARTDESK_SESSION_SECRET=smartdesk_apenas_aula_chave_sessao_demo_2026_alterar

# Notebook 18: serviço Ollama já criado no Notebook 17, acessível pela rede Docker.
# Não são necessárias credenciais nem API key para o Ollama local.
OLLAMA_URL=http://ollama-primeit:11434
OLLAMA_MODEL=gemma3:270m

# Não definir DATABASE_URL aqui: compose.yaml constrói-o com o hostname interno db.
